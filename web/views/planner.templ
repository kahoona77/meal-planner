package views

import (
	"meal-planner/meals"
	"meal-planner/planner"
	"strconv"
)

templ weekPage(week planner.Week, featured *planner.MealOfTheDay, featuredTags []*meals.MealTag) {
	@layout() {
		<div class="mb-4 flex items-center justify-between gap-2">
			<a class="btn-icon print:hidden" href={ templ.SafeURL("offset/" + strconv.Itoa(week.Offset-1)) } aria-label="Previous week">
				@icon("img/solid.svg#chevron-left", "size-5")
			</a>
			<div class="text-center">
				<div class="text-xs font-semibold tracking-wider text-primary uppercase">KW { strconv.Itoa(isoWeek(week.Start)) }</div>
				<div class="font-semibold whitespace-nowrap text-gray-900">
					{ week.Start.Format(dateFormat) } – { week.End.Format(dateFormat) }
				</div>
			</div>
			<a class="btn-icon print:hidden" href={ templ.SafeURL("offset/" + strconv.Itoa(week.Offset+1)) } aria-label="Next week">
				@icon("img/solid.svg#chevron-right", "size-5")
			</a>
		</div>
		// a list on small screens, one column per day (like a calendar) on large ones
		<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-7 lg:gap-2">
			for _, mod := range week.Meals {
				@weekDay(mod)
			}
		</div>
		if featured != nil {
			@featuredMeal(featured, featuredTags)
		}
		<div class="mt-6 text-center print:hidden">
			<a href={ templ.SafeURL("wizard/" + strconv.Itoa(week.Offset)) } class="btn-primary px-6 py-3">
				@icon("img/solid.svg#wand-magic-sparkles", "size-4")
				Create new
			</a>
		</div>
	}
}

// weekDay is the card of one day of the week; a day without a meal links to the selection
// directly and is drawn with a dashed border.
templ weekDay(mod *planner.MealOfTheDay) {
	{{ empty := mod.Meal.Id == 0 }}
	{{ today := isToday(mod.Date) }}
	<a
		if empty {
			href={ templ.SafeURL("planner/" + mod.Id + "/select") }
		} else {
			href={ templ.SafeURL("planner/" + mod.Id) }
		}
		class={ "group flex items-center gap-3 overflow-hidden rounded-xl p-2 transition lg:flex-col lg:items-stretch lg:gap-0 lg:p-0",
			templ.KV("card hover:shadow-md", !empty), templ.KV("ring-2 ring-primary", !empty && today),
			templ.KV("border-2 border-dashed hover:border-primary hover:bg-primary-50", empty), templ.KV("border-gray-300", empty && !today), templ.KV("border-primary", empty && today) }
	>
		<div class={ "hidden py-2 text-center lg:block", templ.KV("bg-primary text-white", today), templ.KV("text-gray-500", !today) }>
			<div class="text-xs font-semibold tracking-wider uppercase">{ weekdayShort(mod.Date.Weekday()) }</div>
			<div class={ "text-2xl leading-tight font-bold", templ.KV("text-gray-900", !today && !empty), templ.KV("text-gray-400", !today && empty) }>{ mod.Date.Format("2.") }</div>
		</div>
		if empty {
			<div class="flex size-20 shrink-0 items-center justify-center rounded-lg text-gray-300 transition-colors group-hover:text-primary sm:size-24 lg:aspect-square lg:h-auto lg:w-full">
				@icon("img/solid.svg#plus", "size-8")
			</div>
		} else {
			@image(mod.Meal.ImageFileId, mod.Meal.Name, "size-20 shrink-0 rounded-lg sm:size-24 lg:aspect-square lg:h-auto lg:w-full lg:rounded-none")
		}
		<div class="min-w-0 flex-1 lg:p-2.5">
			<p class={ "text-sm lg:hidden", templ.KV("font-semibold text-primary", today), templ.KV("text-gray-500", !today) }>
				{ weekdayName(mod.Date.Weekday()) }, { mod.Date.Format(dateFormat) }
			</p>
			if empty {
				<p class="mt-0.5 text-gray-400 group-hover:text-primary lg:mt-0 lg:text-center lg:text-sm">Essen planen</p>
			} else {
				<p class="mt-0.5 line-clamp-2 font-semibold text-gray-900 lg:mt-0 lg:line-clamp-3 lg:text-sm">{ mod.Meal.Name }</p>
			}
		</div>
	</a>
}

templ mealOfDayPage(mod *planner.MealOfTheDay, tags []*meals.MealTag) {
	@layout(withBack(weekURL(mod.Date))) {
		<article class="card mx-auto max-w-2xl overflow-hidden">
			if mod.Meal.ImageFileId.Valid {
				@image(mod.Meal.ImageFileId, mod.Meal.Name, "aspect-[16/10] w-full")
			} else {
				@imagePlaceholder("h-32 w-full")
			}
			<div class="p-4 sm:p-6">
				@mealOfDayDetails(mod, tags, "")
			</div>
		</article>
	}
}

// featuredMeal shows the meal of today, or of the next planned day, in full below the
// week. Only on large screens, where there is room for it.
templ featuredMeal(mod *planner.MealOfTheDay, tags []*meals.MealTag) {
	<article class="card mt-6 hidden gap-6 p-6 lg:grid lg:grid-cols-[18rem_1fr] print:hidden">
		// stays in view while scrolling through a long description
		<a href={ templ.SafeURL("planner/" + mod.Id) } class="sticky top-18 self-start overflow-hidden rounded-lg">
			@image(mod.Meal.ImageFileId, mod.Meal.Name, "aspect-square w-full")
		</a>
		<div class="min-w-0">
			if isToday(mod.Date) {
				@mealOfDayDetails(mod, tags, "Heute")
			} else {
				@mealOfDayDetails(mod, tags, "Als Nächstes")
			}
		</div>
	</article>
}

// mealOfDayDetails shows date, name, tags and description of a meal of the day; label is
// put in front of the date if not empty.
templ mealOfDayDetails(mod *planner.MealOfTheDay, tags []*meals.MealTag, label string) {
	<div class="flex items-start justify-between gap-4">
		<div class="min-w-0">
			<p class="text-sm font-semibold text-primary">
				if label != "" {
					<span class="tracking-wider uppercase">{ label }</span> ·
				}
				{ weekdayName(mod.Date.Weekday()) }, { mod.Date.Format(dateFormat) }
			</p>
			if mod.Meal.Name != "" {
				<h2 class="mt-1 text-2xl font-bold text-gray-900">{ mod.Meal.Name }</h2>
			} else {
				<h2 class="mt-1 text-2xl font-bold text-gray-400">Nichts geplant</h2>
			}
		</div>
		<a href={ templ.SafeURL("planner/" + mod.Id + "/select") } class="btn-secondary shrink-0">
			@icon("img/regular.svg#pen-to-square", "size-4")
			Ändern
		</a>
	</div>
	if len(tags) > 0 {
		<div class="mt-3 flex flex-wrap gap-1.5">
			for _, tag := range tags {
				@tagChip(tag.Tag)
			}
		</div>
	}
	if mod.Meal.Description != "" {
		<div class="prose prose-gray mt-5 max-w-none">
			// stored HTML from the Trix editor
			@templ.Raw(mod.Meal.Description)
		</div>
	}
}

templ selectMealOfDayPage(mod *planner.MealOfTheDay, allMeals []*meals.Meal) {
	@layout(withBack(selectBackURL(mod))) {
		<form id="meal-select" class="mx-auto max-w-3xl" action={ templ.SafeURL("planner/" + mod.Id + "/select") } method="post">
			<h1 class="mb-3 text-lg font-semibold text-gray-900">
				Essen für { weekdayName(mod.Date.Weekday()) }, { mod.Date.Format(dateFormat) }
			</h1>
			<div class="grid gap-2 sm:grid-cols-2">
				@mealOption("none", "", !mod.MealId.Valid) {
					<div class="flex size-14 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400">
						@icon("img/solid.svg#ban", "size-5")
					</div>
					<span class="flex-1 text-gray-500">- leer -</span>
				}
				for _, meal := range allMeals {
					@mealOption(strconv.FormatInt(meal.Id, 10), strconv.FormatInt(meal.Id, 10), meal.Id == mod.MealId.Int64) {
						@image(meal.ImageFileId, meal.Name, "size-14 shrink-0 rounded-lg")
						<span class="min-w-0 flex-1 font-medium text-gray-900">{ meal.Name }</span>
					}
				}
			</div>
			<div class="sticky bottom-[calc(5rem+env(safe-area-inset-bottom))] mt-4 flex justify-center">
				<button class="btn-primary w-full py-3 shadow-lg sm:w-auto sm:px-10" type="submit">Speichern</button>
			</div>
		</form>
	}
}

// mealOption is one selectable row of the meal of the day selection; the whole row is the
// label of a visually hidden radio button.
templ mealOption(id string, value string, checked bool) {
	<label class="card group flex cursor-pointer items-center gap-3 p-2 has-checked:bg-primary-50 has-checked:ring-2 has-checked:ring-primary has-focus-visible:ring-2 has-focus-visible:ring-primary/40">
		<input class="sr-only" type="radio" id={ id } name="selected" value={ value } checked?={ checked }/>
		{ children... }
		<span class="invisible mr-1 text-primary group-has-checked:visible">
			@icon("img/solid.svg#circle-check", "size-5")
		</span>
	</label>
}
