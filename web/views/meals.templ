package views

import (
	"meal-planner/meals"
	"meal-planner/web"
	"strconv"
)

templ mealsPage(mealsWithTags []*MealWithTags) {
	@layout(nil) {
		<div class="meals">
			for _, meal := range mealsWithTags {
				<a href={ templ.SafeURL("meals/" + strconv.FormatInt(meal.Id, 10)) } class="card card-1 meal">
					<div class="image">
						@image(meal.ImageFileId, meal.Name)
					</div>
					<div class="title">
						<div class="text">{ meal.Name }</div>
					</div>
					<div class="tags">
						for _, tag := range meal.Tags {
							<div style={ colorStyle("background-color", tag.Color) }>
								<span class="text-white ">{ tag.Name }</span>
							</div>
						}
					</div>
				</a>
			}
			<a href="meals/new" class="flab">
				<svg>
					<use xlink:href={ web.Asset(ctx, "img/solid.svg#plus") }></use>
				</svg>
			</a>
		</div>
	}
}

templ mealEditHead() {
	<link rel="stylesheet" type="text/css" href={ web.Asset(ctx, "trix.css") }/>
	<script type="text/javascript" src={ web.Asset(ctx, "trix.js") }></script>
	<script type="text/javascript" src={ web.Asset(ctx, "image-select.js") }></script>
}

templ mealEditPage(meal *meals.Meal, tagSelect TagSelect) {
	@layout(mealEditHead()) {
		<div class="meals-edit">
			<form id="meal-delete" action={ templ.SafeURL("meals/" + strconv.FormatInt(meal.Id, 10) + "/delete") } method="post" hidden></form>
			<form id="meal-edit" action={ templ.SafeURL(mealSaveURL(meal)) } method="post" enctype="multipart/form-data">
				<div class="my-2">
					<image-select name="image" src={ fileURL(meal.ImageFileId) }></image-select>
				</div>
				<div class="my-2">
					<label for="name">Name</label>
					<input type="text" id="name" name="name" value={ meal.Name }/>
				</div>
				<div class="my-2">
					<label>Tags</label>
					@tagSelectInput(tagSelect)
				</div>
				<div class="my-2">
					<label for="description">Beschreibung</label>
					<input id="description" type="hidden" name="description" value={ meal.Description }/>
					<trix-editor input="description"></trix-editor>
				</div>
			</form>
			<div class="sticky bottom-0 text-center bg-white">
				<button class="btn" type="submit" form="meal-delete">Delete</button>
				<button class="btn primary" type="submit" form="meal-edit">Save</button>
			</div>
		</div>
	}
}

func mealSaveURL(meal *meals.Meal) string {
	if meal.Id > 0 {
		return "meals/" + strconv.FormatInt(meal.Id, 10)
	}
	return "meals"
}
