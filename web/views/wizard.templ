package views

import (
	"strconv"
	"time"
)

// wizardDay is one row of the wizard: a weekday and the tags meals for it should have.
type wizardDay struct {
	Weekday   time.Weekday
	TagSelect TagSelect
}

templ wizardPage(offset int, start time.Time, end time.Time, days []wizardDay) {
	@layout() {
		<form class="mx-auto max-w-3xl" action={ templ.SafeURL("wizard/" + strconv.Itoa(offset)) } method="post">
			<div class="mb-4 text-center">
				<div class="text-xs font-semibold tracking-wider text-primary uppercase">KW { strconv.Itoa(isoWeek(start)) }</div>
				<div class="font-semibold text-gray-900">{ start.Format(dateFormat) } – { end.Format(dateFormat) }</div>
			</div>
			<div class="card divide-y divide-gray-100">
				for _, day := range days {
					<div class="grid gap-2 p-3 sm:grid-cols-[7rem_1fr] sm:items-center sm:gap-4 sm:p-4">
						<div class="font-semibold text-gray-900">{ weekdayName(day.Weekday) }</div>
						@tagSelectInput(day.TagSelect)
					</div>
				}
			</div>
			<div class="mt-6 text-center">
				<button type="submit" class="btn-primary px-6 py-3">
					@icon("img/solid.svg#wand-magic-sparkles", "size-4")
					Generate
				</button>
			</div>
		</form>
	}
}
